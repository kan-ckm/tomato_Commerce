# ===================================================
# Root .gitignore for Tomato Ban Hang (Fullstack App)
# ===================================================

# 1. Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
!*.env.example
!env.sample
!.env.sample

# 2. Dependencies
node_modules/
/.pnp
.pnp.js

# 3. Build & Test Artifacts
build/
dist/
dist-ssr/
coverage/
.cache/
.parcel-cache/

# 4. Uploaded Files & Dynamic Media
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# 5. Executables & CLI Binaries
*.exe
*.dll
*.so
*.dylib
backend/config/stripe_1.26.1_windows_x86_64/
stripe_*/

# 6. Database Dumps & Sensitive Data
data/Kan-ban-hang/
*.bson.gz
*.metadata.json.gz
*.dump
*.bson
*.sqlite
*.sqlite3
*.db

# 7. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 8. Editor & OS Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
